project Validator is
   for Source_Dirs use ("src", "harness", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("validate_cli.adb", "test_validator.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnato", "-O1");
   end Compiler;
   package Prove is
      for Proof_Dir use "proof/gnatprove";
   end Prove;
end Validator;
